# Copy to .env, fill in locally, then restart python server.py. Never commit .env.
OPSPILOT_API_KEY=
OPSPILOT_MODEL=
OPSPILOT_BASE_URL=https://api.openai.com/v1
OPSPILOT_TIMEOUT_SECONDS=20
# Optional current provider prices, USD per million tokens. Leave blank if unknown.
OPSPILOT_INPUT_USD_PER_MILLION=
OPSPILOT_OUTPUT_USD_PER_MILLION=

# Optional authenticated Gunicorn / Docker deployment; choose your own strong password.
OPSPILOT_ACCESS_USER=opspilot
OPSPILOT_ACCESS_PASSWORD=
OPSPILOT_TRUSTED_HOSTS=localhost,127.0.0.1
